<title language="en" type="main">OGC MUDDI Conceptual Model</title>
<docidentifier type="ogc-internal" primary="true">22-999</docidentifier><docidentifier type="ogc-external">http://www.opengis.net/doc/XXX/YYYYY</docidentifier><docnumber>22-999</docnumber><date type="published"><on>2023-01-01</on></date><date type="issued"><on>2023-01-01</on></date><date type="received"><on>2023-01-01</on></date><contributor><role type="author"><description>committee</description></role><organization>
